{
  "name": "@prismalens/assayer",
  "version": "0.1.0",
  "description": "Leases review jobs, runs an engine over the Agent Client Protocol, and emits assayer/v1 events.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prismalens/assayer.git",
    "directory": "runner"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src/*.js",
    "src/*.py",
    "src/*.sh",
    "prompt/*.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  },
  "bin": {
    "assayer": "src/review.js",
    "assayer-run": "src/run.js",
    "assayer-runner": "src/daemon.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "zod": "^3.23.0"
  }
}
